{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "defaultBase": "master",
  "workspaceLayout": {
    "appsDir": "apps",
    "libsDir": "libs"
  },
  "plugins": [
    {
      "plugin": "@nx/eslint/plugin",
      "options": {
        "targetName": "eslint:lint"
      }
    },
    {
      "plugin": "@nx/js/typescript",
      "include": ["packages/sequelize-guard/**/*"],
      "options": {
        "typecheck": { "targetName": "vite:typecheck" },
        "build": false
      }
    },
    {
      "plugin": "@nx/vite/plugin"
    },
    {
      "plugin": "@nx/vitest",
      "options": {
        "testTargetName": "vite:test"
      }
    }
  ],
  "nxCloudId": "6926732bc3d8b52522afb790",
  "generators": {}
}
