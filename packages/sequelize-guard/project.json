{
  "name": "sequelize-guard",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "{projectRoot}/src",
  "projectType": "library",
  "tags": [],
  "namedInputs": {
    "default": [
      "{projectRoot}/**/*",
      "{workspaceRoot}/scripts/test-package.mjs",
      "{workspaceRoot}/.github/workflows/ci-test.yml",
      "{workspaceRoot}/.github/workflows/release.yml",
      "{workspaceRoot}/eslint.config.mjs",
      "{workspaceRoot}/tsconfig.base.json",
      "{workspaceRoot}/tsconfig.json",
      "{workspaceRoot}/tsconfig.eslint.json",
      "{workspaceRoot}/README.md",
      "{workspaceRoot}/LICENSE",
      "{workspaceRoot}/skills/sequelize-guard/**/*",
      "{workspaceRoot}/examples/**/*",
      "{workspaceRoot}/scripts/test-ai-guidance.mjs",
      "{workspaceRoot}/scripts/check-docs.mjs",
      "{workspaceRoot}/apps/sequelize-guard-docs/content/docs/**/*",
      "{workspaceRoot}/apps/sequelize-guard-docs/src/lib/ai-discovery.mjs",
      "{workspaceRoot}/apps/sequelize-guard-docs/src/app/llms*/**/*",
      "{workspaceRoot}/apps/sequelize-guard-docs/source.config.ts"
    ]
  },
  "targets": {
    "test:package": {
      "dependsOn": [
        "build"
      ]
    }
