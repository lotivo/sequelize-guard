{
  "name": "sequelize-guard",
  "version": "6.1.0",
  "description": "An Authorization Library for Sequelize",
  "license": "MIT",
  "keywords": [
    "sequelize-guard",
    "guard",
    "sequelize",
    "authorize",
    "authorization",
    "guard-sequelize",
    "role",
    "permission",
    "acl",
    "sequelize-acl"
  ],
  "author": {
    "name": "Pankaj Vaghela",
    "email": "vpankaj1998official@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/lotivo/sequelize-guard.git",
    "directory": "packages/sequelize-guard"
  },
  "bugs": {
    "url": "https://github.com/lotivo/sequelize-guard/issues"
  },
  "homepage": "https://github.com/lotivo/sequelize-guard#readme",
  "engines": {
    "node": ">=22.17.1"
  },
  "type": "module",
  "main": "dist/cjs/index.cjs",
  "module": "dist/esm/index.esm.js",
  "types": "types/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./types/index.d.ts",
        "default": "./dist/esm/index.esm.js"
      },
      "require": {
        "types": "./types/index.d.cts",
        "default": "./dist/cjs/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "types",
    "README.md",
    "LICENSE",
    "skills/sequelize-guard/SKILL.md",
    "skills/sequelize-guard/references/installed-package.mjs",
    "examples/README.md",
    "examples/basic.mjs",
    "examples/basic.cjs",
    "examples/custom-user.ts",
    "examples/migrations.mjs",
    "examples/authorization.mjs",
    "examples/advanced.mjs",
    "examples/upgrade.mjs"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "check:prettier": "prettier -c src/",
    "format:prettier": "prettier -w src/",
    "format:staged": "prettier --write",
    "lint:staged": "eslint --fix --max-warnings 0",
    "lint:staged:js": "eslint --fix",
    "pre-commit": "yarn lint-staged && yarn typecheck",
    "test:package": "node --test ../../scripts/test-package.mjs"
  },
  "dependencies": {
    "tslib": "^2.3.0",
    "lodash": "^4.18.1",
    "node-cache": "^5.1.2",
    "sequelize": "^6.37.8"
  },
  "peerDependencies": {
    "sequelize": "^6.37.8"
  }
}
